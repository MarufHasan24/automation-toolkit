    {
      "ConcreteType": "DSRevitNodesUI.FamilyTypes, DSRevitNodesUI",
      "SelectedIndex": 719,
      "SelectedString": "M_Window-Fixed:750 x 1650mm",
      "Id": "91320d6f2bcc42c785fddf31ad63117b",
