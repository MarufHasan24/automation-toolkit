    },
    {
      "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels",
      "SerializedWidth": 350.49056603773585,
      "SerializedHeight": 726.3396226415094,
      "Id": "67c399af5cb6430a8bda074faa033965",
      "NodeType": "StringInputNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "1cb595a3f4924057a2189b999f50a4a1",
          "Name": "",
          "Description": "String",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Creates a string.",
      "InputValue": "import clr\r\nimport random\r\nimport math\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# ============================================================\r\n# INPUTS\r\n# ============================================================\r\n\r\ncad_element = UnwrapElement(IN[0])\r\nwall_type = UnwrapElement(IN[1])\r\nbase_level = UnwrapElement(IN[2])\r\nmin_level = UnwrapElement(IN[3])\r\nmax_level = UnwrapElement(IN[4])\r\nroof_type = UnwrapElement(IN[5])\r\n\r\n\r\n# ============================================================\r\n# HEIGHT RANGE\r\n# ============================================================\r\n\r\nbase_elev = base_level.Elevation\r\nmin_height = min_level.Elevation - base_elev\r\nmax_height = max_level.Elevation - base_elev\r\n\r\n\r\n# ============================================================\r\n# FIND CLOSED POLYLINES\r\n# ============================================================\r\n\r\nclosed_polylines = []\r\n\r\n\r\ndef collect_geometry(geometry, transform):\r\n\r\n    for geo in geometry:\r\n\r\n        if isinstance(geo, PolyLine):\r\n\r\n            pts = geo.GetCoordinates()\r\n\r\n            if pts is None or len(pts) < 3:\r\n                continue\r\n\r\n            new_pts = []\r\n\r\n            for p in pts:\r\n                new_pts.append(transform.OfPoint(p))\r\n\r\n            # Remove duplicate last point\r\n            if new_pts[0].DistanceTo(new_pts[-1]) < 0.01:\r\n                new_pts = new_pts[:-1]\r\n\r\n            if len(new_pts) >= 3:\r\n                closed_polylines.append(new_pts)\r\n\r\n        elif isinstance(geo, GeometryInstance):\r\n\r\n            new_transform = transform.Multiply(\r\n                geo.Transform\r\n            )\r\n\r\n            collect_geometry(\r\n                geo.GetInstanceGeometry(),\r\n                new_transform\r\n            )\r\n\r\n\r\noptions = Options()\r\noptions.ComputeReferences = False\r\noptions.IncludeNonVisibleObjects = True\r\n\r\ngeometry = cad_element.get_Geometry(options)\r\n\r\nif geometry:\r\n    collect_geometry(\r\n        geometry,\r\n        Transform.Identity\r\n    )\r\n\r\n\r\n# ============================================================\r\n# OUTPUT LISTS\r\n# ============================================================\r\n\r\nall_walls = []\r\nall_roofs = []\r\nheights = []\r\nroof_errors = []\r\n\r\n\r\n# ============================================================\r\n# TRANSACTION\r\n# ============================================================\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n\r\n# ============================================================\r\n# PROCESS EVERY BLOCK\r\n# ============================================================\r\n\r\nfor block_number, points in enumerate(closed_polylines):\r\n\r\n    # --------------------------------------------------------\r\n    # ONE RANDOM HEIGHT FOR THIS BLOCK\r\n    # --------------------------------------------------------\r\n\r\n    height = random.uniform(\r\n        min_height,\r\n        max_height\r\n    )\r\n\r\n    heights.append(height)\r\n\r\n    block_walls = []\r\n\r\n\r\n    # ========================================================\r\n    # WALLS\r\n    # ========================================================\r\n\r\n    for i in range(len(points)):\r\n\r\n        p1 = points[i]\r\n        p2 = points[(i + 1) % len(points)]\r\n\r\n        if p1.DistanceTo(p2) < 0.01:\r\n            continue\r\n\r\n        try:\r\n\r\n            line = Line.CreateBound(p1, p2)\r\n\r\n            wall = Wall.Create(\r\n                doc,\r\n                line,\r\n                wall_type.Id,\r\n                base_level.Id,\r\n                height,\r\n                0.0,\r\n                False,\r\n                False\r\n            )\r\n\r\n            block_walls.append(wall)\r\n\r\n        except Exception:\r\n            pass\r\n\r\n\r\n    all_walls.append(block_walls)\r\n\r\n\r\n    # ========================================================\r\n    # ROOF\r\n    # ========================================================\r\n\r\n    try:\r\n\r\n        footprint = CurveArray()\r\n\r\n        for i in range(len(points)):\r\n\r\n            p1 = points[i]\r\n            p2 = points[(i + 1) % len(points)]\r\n\r\n            if p1.DistanceTo(p2) < 0.01:\r\n                continue\r\n\r\n            footprint.Append(\r\n                Line.CreateBound(p1, p2)\r\n            )\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # CREATE ROOF\r\n        # ----------------------------------------------------\r\n\r\n        model_curves = ModelCurveArray()\r\n\r\n        result = doc.Create.NewFootPrintRoof(\r\n            footprint,\r\n            base_level,\r\n            roof_type,\r\n            model_curves\r\n        )\r\n\r\n        # PythonNet3 tuple\r\n        roof = result[0]\r\n        model_curves = result[1]\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # MOVE ROOF TO WALL HEIGHT\r\n        # ----------------------------------------------------\r\n\r\n        offset = roof.get_Parameter(\r\n            BuiltInParameter.ROOF_LEVEL_OFFSET_PARAM\r\n        )\r\n\r\n        if offset and not offset.IsReadOnly:\r\n            offset.Set(height)\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # PITCH\r\n        # ----------------------------------------------------\r\n\r\n        for mc in model_curves:\r\n\r\n            try:\r\n\r\n                roof.set_DefinesSlope(\r\n                    mc,\r\n                    True\r\n                )\r\n\r\n                roof.set_SlopeAngle(\r\n                    mc,\r\n                    math.radians(30)\r\n                )\r\n\r\n            except:\r\n                pass\r\n\r\n\r\n        all_roofs.append(roof)\r\n\r\n\r\n    except Exception as e:\r\n\r\n        # Don't stop other buildings\r\n        all_roofs.append(None)\r\n\r\n        roof_errors.append(\r\n            \"Block {} → {}\".format(\r\n                block_number + 1,\r\n                str(e)\r\n            )\r\n        )\r\n\r\n\r\n# ============================================================\r\n# FINISH\r\n# ============================================================\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n\r\n# ============================================================\r\n# FLATTEN WALLS\r\n# ============================================================\r\n\r\nwalls_flat = []\r\n\r\nfor block in all_walls:\r\n\r\n    for wall in block:\r\n        walls_flat.append(wall)\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = (\r\n    walls_flat,\r\n    all_roofs,\r\n    heights,\r\n    roof_errors\r\n)"
    },
    {
