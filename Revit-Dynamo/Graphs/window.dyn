    {
      "ConcreteType": "DSRevitNodesUI.FamilyTypes, DSRevitNodesUI",
      "SelectedIndex": 715,
      "SelectedString": "M_Window-Double-Hung:700 x 1200mm",
      "Id": "ec724685b2e24b33a623259d41c43a56",
      "NodeType": "ExtensionNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "1d43a4edd33c436bad4530364f4612e6",
          "Name": "Family Type",
          "Description": "The selected Family Type",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "All family types available in the document."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "\r\nimport clr\r\nimport random\r\nimport math\r\n\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import StructuralType\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# ============================================================\r\n# INPUTS\r\n# IN[0]  = Facade walls (may have different heights)\r\n# IN[1]  = Window Family Types list\r\n# IN[2]  = Shading fin Wall Type\r\n# IN[3]  = Minimum gap (mm)\r\n# IN[4]  = Edge clearance (mm)\r\n# IN[5]  = Minimum sill height (mm)\r\n# IN[6]  = Maximum sill height (mm)\r\n# IN[7]  = Minimum fin height (mm)\r\n# IN[8]  = Maximum fin height (mm)\r\n# IN[9]  = Minimum fin projection (mm)\r\n# IN[10] = Maximum fin projection (mm)\r\n# IN[11] = Probability of fin, e.g. 0.10\r\n# IN[12] = Random seed\r\n# IN[13] = Level list L1-L7\r\n# ============================================================\r\n\r\ndef as_list(value):\r\n    if value is None:\r\n        return []\r\n    if isinstance(value, list):\r\n        return [UnwrapElement(x) for x in value if x is not None]\r\n    return [UnwrapElement(value)]\r\n\r\nwalls = as_list(IN[0])\r\nwindow_types = as_list(IN[1])\r\nfin_type = UnwrapElement(IN[2])\r\nmin_gap = float(IN[3]) / 304.8\r\nedge_clearance = float(IN[4]) / 304.8\r\nmin_sill = float(IN[5]) / 304.8\r\nmax_sill = float(IN[6]) / 304.8\r\nmin_fin_height = float(IN[7]) / 304.8\r\nmax_fin_height = float(IN[8]) / 304.8\r\nmin_fin_depth = float(IN[9]) / 304.8\r\nmax_fin_depth = float(IN[10]) / 304.8\r\nfin_probability = max(0.0, min(1.0, float(IN[11])))\r\nseed = int(IN[12])\r\nlevels = sorted(as_list(IN[13]), key=lambda x: x.Elevation)\r\n\r\nCOVERAGE_TARGET = float(IN[14])\r\nTOL = 1.0 / 304.8  # 1 mm in Revit internal feet\r\nMAX_ATTEMPTS_PER_WALL = 500\r\nrng = random.Random(seed)\r\n\r\n# ============================================================\r\n# VALIDATE INPUTS\r\n# ============================================================\r\n\r\nif not walls:\r\n    raise Exception(\"IN[0]: Select facade walls.\")\r\n\r\nif not window_types:\r\n    raise Exception(\"IN[1]: Select loaded window family types.\")\r\n\r\nif not isinstance(fin_type, WallType):\r\n    raise Exception(\"IN[2]: Select a valid wall type for shading fins.\")\r\n\r\nif not levels:\r\n    raise Exception(\"IN[13]: Connect the level list L1-L7.\")\r\n\r\nif min_gap < 0 or edge_clearance < 0:\r\n    raise Exception(\"Gap and edge clearance must be non-negative.\")\r\n\r\nif min_sill < 0 or max_sill < min_sill:\r\n    raise Exception(\"Check the sill height range.\")\r\n\r\nif min_fin_height <= 0 or max_fin_height < min_fin_height:\r\n    raise Exception(\"Check the fin height range.\")\r\n\r\nif min_fin_depth <= 0 or max_fin_depth < min_fin_depth:\r\n    raise Exception(\"Check the fin projection range.\")\r\n\r\n# ============================================================\r\n# WINDOW TYPE DIMENSIONS\r\n# ============================================================\r\n\r\ndef get_dimension(symbol, names):\r\n    for name in names:\r\n        try:\r\n            p = symbol.LookupParameter(name)\r\n            if p and p.StorageType == StorageType.Double:\r\n                value = p.AsDouble()\r\n                if value > 0:\r\n                    return value\r\n        except:\r\n            pass\r\n    return None\r\n\r\nwindow_options = []\r\n\r\nfor symbol in window_types:\r\n    if not isinstance(symbol, FamilySymbol):\r\n        continue\r\n\r\n    width = get_dimension(\r\n        symbol, [\"Width\", \"Rough Width\", \"width\", \"rough width\"]\r\n    )\r\n    height = get_dimension(\r\n        symbol, [\"Height\", \"Rough Height\", \"height\", \"rough height\"]\r\n    )\r\n\r\n    if width and height:\r\n        window_options.append({\r\n            \"symbol\": symbol,\r\n            \"width\": width,\r\n            \"height\": height\r\n        })\r\n\r\nif not window_options:\r\n    raise Exception(\r\n        \"No usable window types found. Each type needs numeric Width \"\r\n        \"and Height parameters. Add your family's actual parameter \"\r\n        \"names to get_dimension() if necessary.\"\r\n    )\r\n\r\n# ============================================================\r\n# GEOMETRY HELPERS\r\n# ============================================================\r\n\r\ndef get_wall_axis(wall):\r\n    curve = wall.Location.Curve\r\n    p0 = curve.GetEndPoint(0)\r\n    p1 = curve.GetEndPoint(1)\r\n    return p0, (p1 - p0).Normalize(), curve.Length\r\n\r\ndef point_at(p0, direction, station, z):\r\n    return XYZ(\r\n        p0.X + direction.X * station,\r\n        p0.Y + direction.Y * station,\r\n        z\r\n    )\r\n\r\ndef id_key(element):\r\n    return str(element.Id)\r\n\r\ndef bbox_interval(element, p0, direction):\r\n    bbox = element.get_BoundingBox(None)\r\n    if bbox is None:\r\n        return None\r\n\r\n    projections = []\r\n    for x in (bbox.Min.X, bbox.Max.X):\r\n        for y in (bbox.Min.Y, bbox.Max.Y):\r\n            for z in (bbox.Min.Z, bbox.Max.Z):\r\n                pt = XYZ(x, y, z)\r\n                delta = pt - p0\r\n                projections.append(\r\n                    delta.X * direction.X +\r\n                    delta.Y * direction.Y\r\n                )\r\n\r\n    return {\r\n        \"left\": min(projections),\r\n        \"right\": max(projections),\r\n        \"bottom\": bbox.Min.Z,\r\n        \"top\": bbox.Max.Z\r\n    }\r\n\r\ndef interval_conflict(a, b, gap):\r\n    horizontal = (\r\n        a[\"left\"] < b[\"right\"] + gap - TOL and\r\n        a[\"right\"] > b[\"left\"] - gap + TOL\r\n    )\r\n    vertical = (\r\n        a[\"bottom\"] < b[\"top\"] - TOL and\r\n        a[\"top\"] > b[\"bottom\"] + TOL\r\n    )\r\n    return horizontal and vertical\r\n\r\ndef get_floor_zones(wall):\r\n    bbox = wall.get_BoundingBox(None)\r\n    if bbox is None:\r\n        return []\r\n\r\n    wall_bottom = bbox.Min.Z\r\n    wall_top = bbox.Max.Z\r\n\r\n    usable_levels = [\r\n        lv for lv in levels\r\n        if lv.Elevation >= wall_bottom - TOL\r\n        and lv.Elevation < wall_top - TOL\r\n    ]\r\n\r\n    zones = []\r\n\r\n    for i, level in enumerate(usable_levels):\r\n        base = max(wall_bottom, level.Elevation)\r\n\r\n        if i + 1 < len(usable_levels):\r\n            top = min(wall_top, usable_levels[i + 1].Elevation)\r\n        else:\r\n            top = wall_top\r\n\r\n        if top - base > TOL:\r\n            zones.append({\r\n                \"level\": level,\r\n                \"base\": base,\r\n                \"top\": top\r\n            })\r\n\r\n    return zones\r\n\r\n# ============================================================\r\n# LEVEL-BY-LEVEL PLANNING\r\n# For each level, process all wall zones before advancing.\r\n# Coverage is measured per wall per floor zone.\r\n# Gaps do not count as occupied facade.\r\n# ============================================================\r\n\r\nplans = []\r\nskipped = []\r\nlevel_report = []\r\n\r\nfor level in levels:\r\n    level_candidates = []\r\n\r\n    for wall in walls:\r\n        if not isinstance(wall, Wall):\r\n            continue\r\n\r\n        if not isinstance(wall.Location, LocationCurve):\r\n            skipped.append(\"Invalid wall location: \" + id_key(wall))\r\n            continue\r\n\r\n        if not isinstance(wall.Location.Curve, Line):\r\n            skipped.append(\"Curved wall skipped: \" + id_key(wall))\r\n            continue\r\n\r\n        bbox = wall.get_BoundingBox(None)\r\n        if bbox is None:\r\n            continue\r\n\r\n        p0, direction, length = get_wall_axis(wall)\r\n        if length <= 0:\r\n            continue\r\n\r\n        # Process this wall only if the current level defines one\r\n        # of its floor zones.\r\n        zones = get_floor_zones(wall)\r\n        zone = None\r\n\r\n        for z in zones:\r\n            if id_key(z[\"level\"]) == id_key(level):\r\n                zone = z\r\n                break\r\n\r\n        if zone is None:\r\n            continue\r\n\r\n        normal = wall.Orientation\r\n        normal = XYZ(normal.X, normal.Y, 0)\r\n\r\n        if normal.GetLength() < 0.000001:\r\n            skipped.append(\"Invalid wall normal: \" + id_key(wall))\r\n            continue\r\n\r\n        normal = normal.Normalize()\r\n\r\n        usable_length = length - 2.0 * edge_clearance\r\n        if usable_length <= TOL:\r\n            skipped.append(\"No usable length: \" + id_key(wall))\r\n            continue\r\n\r\n        floor_height = zone[\"top\"] - zone[\"base\"]\r\n        station = edge_clearance\r\n        occupied = 0.0\r\n        target = usable_length * COVERAGE_TARGET\r\n        attempts = 0\r\n        wall_plans = []\r\n\r\n        while occupied < target and attempts < MAX_ATTEMPTS_PER_WALL:\r\n            attempts += 1\r\n\r\n            remaining = length - edge_clearance - station\r\n            if remaining <= TOL:\r\n                break\r\n\r\n            # Randomly decide whether this candidate is a fin.\r\n            choose_fin = rng.random() < fin_probability\r\n\r\n            fitting_windows = [\r\n                item for item in window_options\r\n                if item[\"height\"] + min_sill <= floor_height + TOL\r\n            ]\r\n\r\n            if not fitting_windows:\r\n                choose_fin = True\r\n\r\n            if choose_fin:\r\n                # Fin thickness occupies facade width; projection is\r\n                # perpendicular and does not count as facade coverage.\r\n                fin_footprint = fin_type.Width\r\n\r\n                if fin_footprint + min_gap > remaining:\r\n                    break\r\n\r\n                fin_height = min(\r\n                    rng.uniform(min_fin_height, max_fin_height),\r\n                    floor_height\r\n                )\r\n\r\n                if fin_height <= TOL:\r\n                    break\r\n\r\n                candidate = {\r\n                    \"kind\": \"fin\",\r\n                    \"wall\": wall,\r\n                    \"level\": level,\r\n                    \"p0\": p0,\r\n                    \"direction\": direction,\r\n                    \"normal\": normal,\r\n                    \"station\": station + fin_footprint / 2.0,\r\n                    \"base\": zone[\"base\"],\r\n                    \"height\": fin_height,\r\n                    \"depth\": rng.uniform(min_fin_depth, max_fin_depth),\r\n                    \"footprint\": fin_footprint\r\n                }\r\n\r\n            else:\r\n                item = rng.choice(fitting_windows)\r\n                width = item[\"width\"]\r\n                height = item[\"height\"]\r\n\r\n                if width + min_gap > remaining:\r\n                    break\r\n\r\n                sill_max = min(max_sill, floor_height - height)\r\n                if sill_max < min_sill:\r\n                    break\r\n\r\n                sill = rng.uniform(min_sill, sill_max)\r\n\r\n                candidate = {\r\n                    \"kind\": \"window\",\r\n                    \"wall\": wall,\r\n                    \"level\": level,\r\n                    \"p0\": p0,\r\n                    \"direction\": direction,\r\n                    \"station\": station + width / 2.0,\r\n                    \"base\": zone[\"base\"],\r\n                    \"point\": point_at(\r\n                        p0, direction, station + width / 2.0,\r\n                        zone[\"base\"] + sill\r\n                    ),\r\n                    \"symbol\": item[\"symbol\"],\r\n                    \"width\": width,\r\n                    \"height\": height,\r\n                    \"sill\": sill,\r\n                    \"footprint\": width\r\n                }\r\n\r\n            # Candidate is appended; next candidate starts after its\r\n            # facade footprint plus the required gap.\r\n            wall_plans.append(candidate)\r\n            occupied += candidate[\"footprint\"]\r\n            station += candidate[\"footprint\"] + min_gap\r\n\r\n        plans.extend(wall_plans)\r\n\r\n        level_candidates.append({\r\n            \"wall_id\": id_key(wall),\r\n            \"usable_length_ft\": usable_length,\r\n            \"target_coverage\": COVERAGE_TARGET,\r\n            \"planned_coverage\": (\r\n                occupied / usable_length if usable_length > 0 else 0\r\n            ),\r\n            \"candidate_count\": len(wall_plans)\r\n        })\r\n\r\n    level_report.append({\r\n        \"level\": level.Name,\r\n        \"walls\": level_candidates\r\n    })\r\n\r\n# ============================================================\r\n# RESERVE FINS BEFORE WINDOW PLACEMENT\r\n# Reject windows whose nominal footprint conflicts with a fin.\r\n# ============================================================\r\n\r\nplanned_fins = [p for p in plans if p[\"kind\"] == \"fin\"]\r\nvalid_plans = []\r\n\r\nfor plan in plans:\r\n    if plan[\"kind\"] == \"fin\":\r\n        valid_plans.append(plan)\r\n        continue\r\n\r\n    win_left = plan[\"station\"] - plan[\"width\"] / 2.0\r\n    win_right = plan[\"station\"] + plan[\"width\"] / 2.0\r\n    win_bottom = plan[\"base\"] + plan[\"sill\"]\r\n    win_top = win_bottom + plan[\"height\"]\r\n\r\n    blocked = False\r\n\r\n    for fin in planned_fins:\r\n        if id_key(fin[\"wall\"]) != id_key(plan[\"wall\"]):\r\n            continue\r\n\r\n        fin_left = fin[\"station\"] - fin[\"footprint\"] / 2.0\r\n        fin_right = fin[\"station\"] + fin[\"footprint\"] / 2.0\r\n        fin_bottom = fin[\"base\"]\r\n        fin_top = fin_bottom + fin[\"height\"]\r\n\r\n        horizontal = (\r\n            win_left < fin_right + min_gap and\r\n            win_right > fin_left - min_gap\r\n        )\r\n        vertical = (\r\n            win_bottom < fin_top and\r\n            win_top > fin_bottom\r\n        )\r\n\r\n        if horizontal and vertical:\r\n            blocked = True\r\n            break\r\n\r\n    if not blocked:\r\n        valid_plans.append(plan)\r\n\r\n# ============================================================\r\n# CREATE FIN WALLS FIRST, THEN WINDOWS\r\n# ============================================================\r\n\r\ncreated_windows = []\r\ncreated_fins = []\r\nwindow_records = []\r\nfin_records = []\r\nerrors = []\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\ntry:\r\n    symbols = {}\r\n    for plan in valid_plans:\r\n        if plan[\"kind\"] == \"window\":\r\n            symbols[id_key(plan[\"symbol\"])] = plan[\"symbol\"]\r\n\r\n    for symbol in symbols.values():\r\n        if not symbol.IsActive:\r\n            symbol.Activate()\r\n\r\n    doc.Regenerate()\r\n\r\n    # Create fins first.\r\n    for plan in valid_plans:\r\n        if plan[\"kind\"] != \"fin\":\r\n            continue\r\n\r\n        try:\r\n            level_z = plan[\"level\"].Elevation\r\n            offset = plan[\"base\"] - level_z\r\n\r\n            start = point_at(\r\n                plan[\"p0\"], plan[\"direction\"], plan[\"station\"],\r\n                level_z\r\n            )\r\n            end = start + plan[\"normal\"] * plan[\"depth\"]\r\n\r\n            fin = Wall.Create(\r\n                doc,\r\n                Line.CreateBound(start, end),\r\n                fin_type.Id,\r\n                plan[\"level\"].Id,\r\n                plan[\"height\"],\r\n                offset,\r\n                False,\r\n                False\r\n            )\r\n\r\n            doc.Regenerate()\r\n\r\n            actual = bbox_interval(\r\n                fin, plan[\"p0\"], plan[\"direction\"]\r\n            )\r\n\r\n            created_fins.append(fin)\r\n\r\n            if actual:\r\n                fin_records.append({\r\n                    \"wall_id\": id_key(plan[\"wall\"]),\r\n                    \"interval\": actual\r\n                })\r\n\r\n        except Exception as ex:\r\n            errors.append(\"Fin placement failed: \" + str(ex))\r\n\r\n    # Create windows and reject actual bounding-box conflicts.\r\n    for plan in valid_plans:\r\n        if plan[\"kind\"] != \"window\":\r\n            continue\r\n\r\n        instance = None\r\n\r\n        try:\r\n            instance = doc.Create.NewFamilyInstance(\r\n                plan[\"point\"],\r\n                plan[\"symbol\"],\r\n                plan[\"wall\"],\r\n                StructuralType.NonStructural\r\n            )\r\n\r\n            doc.Regenerate()\r\n\r\n            actual = bbox_interval(\r\n                instance, plan[\"p0\"], plan[\"direction\"]\r\n            )\r\n\r\n            conflict = actual is None\r\n\r\n            if actual:\r\n                # Ensure actual geometry stays inside the wall edges.\r\n                wall_length = plan[\"wall\"].Location.Curve.Length\r\n\r\n                if (\r\n                    actual[\"left\"] < edge_clearance - TOL or\r\n                    actual[\"right\"] > wall_length - edge_clearance + TOL\r\n                ):\r\n                    conflict = True\r\n\r\n                # Window-to-window spacing.\r\n                for rec in window_records:\r\n                    if rec[\"wall_id\"] != id_key(plan[\"wall\"]):\r\n                        continue\r\n                    if interval_conflict(\r\n                        actual, rec[\"interval\"], min_gap\r\n                    ):\r\n                        conflict = True\r\n                        break\r\n\r\n                # Window-to-fin exclusion.\r\n                for rec in fin_records:\r\n                    if rec[\"wall_id\"] != id_key(plan[\"wall\"]):\r\n                        continue\r\n                    if interval_conflict(\r\n                        actual, rec[\"interval\"], min_gap\r\n                    ):\r\n                        conflict = True\r\n                        break\r\n\r\n            if conflict:\r\n                doc.Delete(instance.Id)\r\n                errors.append(\r\n                    \"Rejected window due to actual overlap or edge clearance: \"\r\n                    + id_key(plan[\"wall\"])\r\n                )\r\n            else:\r\n                created_windows.append(instance)\r\n                window_records.append({\r\n                    \"wall_id\": id_key(plan[\"wall\"]),\r\n                    \"interval\": actual\r\n                })\r\n\r\n        except Exception as ex:\r\n            if instance is not None:\r\n                try:\r\n                    doc.Delete(instance.Id)\r\n                except:\r\n                    pass\r\n            errors.append(\"Window placement failed: \" + str(ex))\r\n\r\nfinally:\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = {\r\n    \"WindowsCreated\": created_windows,\r\n    \"ShadingFinsCreated\": created_fins,\r\n    \"LevelCoveragePlan\": level_report,\r\n    \"PlannedCandidates\": len(plans),\r\n    \"CandidatesAfterFinChecks\": len(valid_plans),\r\n    \"Errors\": errors,\r\n    \"SkippedWalls\": skipped\r\n}",
